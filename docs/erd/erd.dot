    /* --- Relationships (IE / Crow's Foot) ------------------------ */
    /* Audit-column edges (create_uid / write_uid -> res_users) are
       suppressed: every table has them, and drawing 40 edges into one
       node hides the relationships that carry meaning. */

    document_category:r_id:e -> document_category:l_parent_id:w [arrowtail = teeodot, color = "#2f6f5e", label="parent_id", weight = 12];
    document_category:r_id:e -> document_template:l_category_id:w [arrowtail = teeodot, color = "#2f6f5e", label="category_id", weight = 12];
    document_tag:r_id:e -> document_tag_document_template_rel:l_document_tag_id:w [arrowtail = tee, color = "#2f6f5e", label="document_tag_id", weight = 12];
    document_template:r_id:e -> document_tag_document_template_rel:l_document_template_id:w [arrowtail = tee, color = "#2f6f5e", label="document_template_id", weight = 12];
    document_template:r_id:e -> document_template_variable:l_template_id:w [arrowtail = tee, color = "#2f6f5e", label="template_id", weight = 12];
    document_type:r_id:e -> hr_employee_document:l_document_type_id:w [arrowtail = teeodot, color = "#7c5a3a", label="document_type_id", weight = 12];
    hr_applicant:r_id:e -> hr_applicant:l_pool_applicant_id:w [arrowtail = teeodot, color = "#6d3f7a", label="pool_applicant_id", weight = 12];
    hr_applicant_refuse_reason:r_id:e -> hr_applicant:l_refuse_reason_id:w [arrowtail = teeodot, color = "#6d3f7a", label="refuse_reason_id", weight = 12];
    hr_department:r_id:e -> hr_applicant:l_department_id:w [arrowtail = teeodot, color = "#6d3f7a", label="department_id", weight = 12];
