    legend [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8">
        <TR><TD BGCOLOR="#f1f4f8" COLSPAN="2"><B>Legend &#8212; IE (Crow&#8217;s Foot) notation</B></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">primary key</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">foreign key (enforced by the database)</TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">unique constraint</TD></TR>
        <TR><TD ALIGN="LEFT">N</TD><TD ALIGN="LEFT">nullable</TD></TR>
        <TR><TD ALIGN="LEFT">&#9553;&#9472;</TD><TD ALIGN="LEFT">exactly one &#8594; many (mandatory FK)</TD></TR>
        <TR><TD ALIGN="LEFT">&#9675;&#9472;</TD><TD ALIGN="LEFT">zero or one &#8594; many (nullable FK)</TD></TR>
        <TR><TD BGCOLOR="#f1f4f8" COLSPAN="2"><B>Subsystems</B></TD></TR>
        <TR><TD BGCOLOR="#1e3a5f" WIDTH="18"></TD><TD ALIGN="LEFT">employee master &amp; org structure</TD></TR>
        <TR><TD BGCOLOR="#7c2d12" WIDTH="18"></TD><TD ALIGN="LEFT">employee document vault</TD></TR>
        <TR><TD BGCOLOR="#065f46" WIDTH="18"></TD><TD ALIGN="LEFT">document template manager</TD></TR>
        <TR><TD BGCOLOR="#4c1d95" WIDTH="18"></TD><TD ALIGN="LEFT">recruitment pipeline</TD></TR>
        <TR><TD BGCOLOR="#475569" WIDTH="18"></TD><TD ALIGN="LEFT">Odoo framework (boundary)</TD></TR>
        <TR><TD BGCOLOR="#f1f4f8" COLSPAN="2"><B>Column ownership</B></TD></TR>
        <TR><TD BGCOLOR="#fff4e5" WIDTH="18"></TD><TD ALIGN="LEFT">column declared by <B>hr_employee_cleardeals</B></TD></TR>
        <TR><TD BGCOLOR="#e8f5ef" WIDTH="18"></TD><TD ALIGN="LEFT">column declared by <B>document_template_manager</B></TD></TR>
        <TR><TD BGCOLOR="#fdeee8" WIDTH="18"></TD><TD ALIGN="LEFT">column declared by <B>oh_employee_documents_expiry</B></TD></TR>
        <TR><TD BGCOLOR="#fdf6e8" WIDTH="18"></TD><TD ALIGN="LEFT">column declared by <B>hr_employee_updation</B></TD></TR>
        <TR><TD BGCOLOR="#f3ecfb" WIDTH="18"></TD><TD ALIGN="LEFT">column declared by <B>custom_recruitment_fix</B></TD></TR>
        <TR><TD BGCOLOR="#f1f4f8" COLSPAN="2"><B>Notes</B></TD></TR>
        <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">• Column tint marks the module that declared the field. Untinted columns are stock Odoo 19.</FONT></TD></TR>
        <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">• hr.employee carries 63 columns declared by hr_employee_cleardeals — Indian statutory identifiers, banking detail, issued assets and the onboarding document slots exposed by the HR API.</FONT></TD></TR>
        <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#444444">• Odoo 19 has no hr_contract table. Contract and salary data live on hr_version, which versions a single employee over time.</FONT></TD></TR>
      </TABLE>>];
}
